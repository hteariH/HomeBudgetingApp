<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Debug-only overlay: points the app at the cleartext exemption for 10.0.2.2 so a
      developer build can talk to a server on the host machine. The main manifest does
      not set this attribute, so the merger simply adds it here and release builds stay
      HTTPS-only.
    -->
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
