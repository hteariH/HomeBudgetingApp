# Edge site config for the PersonalMoney project page. Deployed to
# /opt/edge/conf.d/personalmoney.caddy.
# personalmoney.app serves only the static page in site/; the app itself runs on each
# user's own server. The site container joins the `edge` network with alias
# `personalmoney-site`. Caddy obtains and renews the Let's Encrypt cert for this
# hostname automatically.
personalmoney.app {
	encode zstd gzip

	# AdMob verifies the publisher id by fetching this file from the developer website
	# named in the Play listings, and personalmoney.app is that domain. It belongs to the
	# domain, not to the project page, so the edge answers it.
	handle /app-ads.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond "google.com, pub-4510992616986316, DIRECT, f08c47fec0942fa0" 200
	}

	# Wrapped in `handle` so it is mutually exclusive with the block above: a bare
	# reverse_proxy directive would otherwise still match /app-ads.txt.
	handle {
		reverse_proxy personalmoney-site:80
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}

www.personalmoney.app {
	redir https://personalmoney.app{uri} permanent
}
