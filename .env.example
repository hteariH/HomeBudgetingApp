# PersonalMoney configuration. Copy to .env next to docker-compose.yml.

# --- Required ---------------------------------------------------------------
# The database password. Pick a long random one; you never type it anywhere else.
#   openssl rand -base64 24
DB_PASSWORD=

# --- Optional ---------------------------------------------------------------
# Image tag and published port.
# PERSONALMONEY_VERSION=latest
# PERSONALMONEY_PORT=8080

# Who may create an account: open | closed. Unset: open until the first account
# (which becomes the administrator) exists, then closed. The first account can
# always be created, so closed means "nobody after the administrator". The
# administrator can toggle it in the app unless it is set here. Any other value
# is logged as a warning and treated as unset.
# REGISTRATION=

# Secrets. Generated into ./data/secrets on first start when unset; set them here
# only to manage them yourself, at least 32 characters each. Changing JWT_SECRET
# signs everyone out; changing CRYPTO_SECRET makes stored bank connections
# unreadable.
# JWT_SECRET=
# CRYPTO_SECRET=

# The address people open PersonalMoney at. Needed for links in emails and for the
# HomeMoney import (HomeMoney sends people back to it), which is offered only when set.
# APP_BASE_URL=https://money.example.com

# Behind a reverse proxy (Caddy, Traefik, Nginx Proxy Manager), set this so the server
# sees each visitor's address and https from the proxy's X-Forwarded-* headers. Without
# it everyone appears to come from the proxy and shares one limit on sign-in attempts.
# SERVER_FORWARD_HEADERS_STRATEGY=native

# --- Mail (optional) --------------------------------------------------------
# Without mail nobody is asked to verify an address, and "forgot password" is
# replaced by reset links the administrator issues. Any SMTP provider works.
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=personalmoney@example.com

# --- Banks (optional) -------------------------------------------------------
# Monobank with a personal token always works. The consent-based corporate API
# needs a company registration with the bank; see docs/monobank-corporate.md.
# MONOBANK_KEY_ID=
# MONOBANK_PRIVATE_KEY=

# HomeMoney import uses HomeMoney's public demo client unless you register your own.
# HOMEMONEY_CLIENT_ID=
# HOMEMONEY_CLIENT_SECRET=
