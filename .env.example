# Copy to /opt/homebudget/.env on the VPS and chmod 600. Deploys never overwrite it,
# which is the point: the file is the durable home of these values on the server.
#
# Keep a copy in a password manager as well. GitHub secrets cannot be read back, so a
# value that exists only there is already effectively lost.

# --- Database ---
DB_USERNAME=homebudget
DB_PASSWORD=replace-me
DB_ROOT_PASSWORD=replace-me

# --- Security ---
# Signs access tokens. Rotating it signs everyone out - annoying, but harmless.
JWT_SECRET=replace-me-with-32-random-bytes

# Encrypts stored bank credentials. Rotating it makes existing bank connections
# unreadable and users must reconnect, so set it once and never change it.
#   openssl rand -base64 32
CRYPTO_SECRET=replace-me-with-32-random-bytes

# --- Public address ---
# Absolute base for links inside emails; a relative link in a mail client goes nowhere.
APP_BASE_URL=https://personalmoney.app

# --- HomeMoney import ---
# homemoney.ua has no self-service app registration: these are issued by hand, on
# request, and the redirect below has to be the one they registered against them.
#   https://personalmoney.app/api/import/homemoney/callback
# Until they answer, their published demo client (5 / demo) is what the defaults use -
# it works for reading, but the consent screen will name the demo application.
HOMEMONEY_CLIENT_ID=5
HOMEMONEY_CLIENT_SECRET=demo

# --- Mail (Resend over SMTP) ---
# Host/port/username are Resend's fixed values and only need changing to move provider.
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
# The Resend API key (re_...).
MAIL_PASSWORD=re_replace-me
# Must be on a domain verified in Resend, or nothing sends.
MAIL_FROM=noreply@personalmoney.app
