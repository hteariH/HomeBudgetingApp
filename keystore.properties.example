# Copy this file to `keystore.properties` (do NOT commit) and fill in real values.
# `app/build.gradle.kts` reads this file at configuration time and skips release signing
# if the file is absent (so debug builds still work on a clean checkout).

storeFile=personalmoney.keystore
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME

# Production AdMob IDs. Leave blank to use the Google test IDs (safe but they show test
# ads only, never billable).
admobAppId=ca-app-pub-XXXXXXXXXXXXXXXX~XXXXXXXXXX
admobBannerUnitId=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX
admobInterstitialUnitId=ca-app-pub-XXXXXXXXXXXXXXXX/XXXXXXXXXX

# Public URL of your hosted Privacy Policy (mandatory for Play Console + AdMob).
privacyPolicyUrl=https://your-domain.example/personalmoney/privacy
